######no of users rated to particular rating
r<-read.csv("C:/Users/Admin/Desktop/New folder/ratings.csv")
r
install.packages("data.table")
library(data.table)
dt <- data.table(r)
dt[, length(user_id[ rating > 0]), by = rating]
######pie chart with percentages
slices <- c(293,383,193,91,53)
lbls <- c("5", "4", "3", "2", "1")
pct <- round(slices/sum(slices)*100)
lbls <- paste(lbls, pct) # add percents to labels
lbls <- paste(lbls,"%",sep="") # ad % to labels
pie(slices,labels = lbls, col=rainbow(length(lbls)),
main="Pie Chart of user and ratings")
####TOP most 5 rated items
r<-read.csv("C:/Users/Admin/Desktop/New folder/ratings.csv")
subset(r,r$rating>=1)
r3<-subset(r,r$rating>=1)
r3
item<-r3$item_id
fre<-table(item)
fre<-as.data.frame(table(item))
print(fre)
sort(table(item),decreasing=TRUE)
sort(table(item),decreasing=TRUE)[1:5]
Most_freq<-sort(table(item),decreasing=TRUE)[1:5]
Most_freq
#####Reading the user id
u<-read.csv("C:/Users/Admin/Desktop/New folder/user_s.csv")
f<-read.csv("C:/Users/Admin/Desktop/New folder/friend.csv")
Read<- function()
{
u_id <- readline("Enter your user ID?")
print(u_id)
return(u_id)
}
u_id=Read()
fid<-subset(f,user_id==u_id) #getting values from friends table
fnew<-fid[!is.na(fid)]  #eliminating N.A values obtained from friends table
length(fnew)
farray<-array(unlist(fnew), dim = c(nrow(fnew),length(fnew))) #converting list into array
farray
#####printing users rating
r<-read.csv("C:/Users/Admin/Desktop/New folder/ratings.csv")
rid<-subset(r,user_id==u_id) #getting values from friends table
rid
#####printig ratings given by his friends
rat<-read.csv("C:/Users/Admin/Desktop/New folder/ratings.csv")
rat1<-c()
for (i in 2:length(fnew)){
ratings1<-subset(rat,rat$user_id==farray[i])
print(ratings1) #printing ratings given by the friends of the user
}
#########matching the items rated by user and his friends
for (i in 2:length(fnew)){
ratings1<-subset(rat,rat$user_id==farray[i])
merge1<-merge(ratings1,rid,by="item_id")
print(merge1)
#print(ratings1) #printing ratings given by the friends of the user
}
